# Copy to .env for local settings; .env is not tracked.
# make compute MODE=gpu adds docker-compose.gpu.yml after checking prerequisites.
COMPOSE_FILE=docker-compose.yml
# Select a specific NVIDIA GPU for GPU mode (index from nvidia-smi).
EMBEDDING_GPU_ID=0
# Model scripts use EMBEDDING_MODEL_FILE exported in your shell.
EMBEDDING_MODEL_FILE=./models/Qwen3-Embedding-0.6B-Q8_0.gguf
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
EMBEDDING_DIM=1024
EMBEDDING_POOLING=last
# Ports and storage profiles are documented in README.md.
